          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"name\" TEXT NOT NULL CHECK (length(trim(name)) > 0), \"kind\" TEXT NOT NULL CHECK (kind IN ('cash', 'bank', 'credit_card', 'e_wallet', 'other')), \"currency\" TEXT NOT NULL REFERENCES currencies(code), \"opening_balance_minor\" INTEGER NOT NULL DEFAULT 0, \"archived\" INTEGER NOT NULL DEFAULT FALSE, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER);"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"name\" TEXT NOT NULL CHECK (length(trim(name)) > 0), \"kind\" TEXT NOT NULL CHECK (kind IN ('expense', 'income')), \"parent_id\" TEXT REFERENCES categories(id), \"icon\" TEXT, \"color\" INTEGER, \"archived\" INTEGER NOT NULL DEFAULT FALSE, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER);"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"type\" TEXT NOT NULL CHECK (type IN ('expense', 'income', 'transfer')), \"occurred_on\" TEXT NOT NULL CHECK (occurred_on GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'), \"account_id\" TEXT NOT NULL REFERENCES accounts(id), \"category_id\" TEXT REFERENCES categories(id), \"amount_minor\" INTEGER NOT NULL CHECK (amount_minor > 0), \"currency\" TEXT NOT NULL REFERENCES currencies(code), \"fx_rate_to_base\" REAL NOT NULL CHECK (fx_rate_to_base > 0), \"base_amount_minor\" INTEGER NOT NULL, \"to_account_id\" TEXT REFERENCES accounts(id), \"to_amount_minor\" INTEGER, \"note\" TEXT NOT NULL DEFAULT '', \"is_starred\" INTEGER NOT NULL DEFAULT FALSE, \"importance\" INTEGER NOT NULL DEFAULT 3 CHECK (importance BETWEEN 1 AND 5), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER, CHECK((type = 'transfer' AND to_account_id IS NOT NULL AND to_amount_minor IS NOT NULL AND to_amount_minor > 0 AND to_account_id <> account_id AND category_id IS NULL)OR(type IN ('expense', 'income') AND to_account_id IS NULL AND to_amount_minor IS NULL AND category_id IS NOT NULL)));"
        }
      ]
    },
    {
      "name": "account_movements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE VIEW account_movements AS SELECT account_id, occurred_on, CASE WHEN type = 'income' THEN amount_minor ELSE -amount_minor END AS delta_minor FROM transactions WHERE deleted_at IS NULL UNION ALL SELECT to_account_id AS account_id, occurred_on, to_amount_minor AS delta_minor FROM transactions WHERE type = 'transfer' AND deleted_at IS NULL"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL PRIMARY KEY, \"value\" TEXT NOT NULL);"
        }
      ]
    },
